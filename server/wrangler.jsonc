{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "taktik-referee",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	// How long a player may stay disconnected during play before they Forfeit.
	"vars": { "FORFEIT_AFTER_SECONDS": 120 },
	"durable_objects": {
		"bindings": [
			{ "name": "QUICK_MATCH", "class_name": "QuickMatchHost" },
			{ "name": "REFEREE", "class_name": "Referee" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuickMatchHost", "Referee"] }]
}
