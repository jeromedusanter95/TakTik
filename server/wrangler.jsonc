{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "taktik-referee",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	"vars": {
		// How long a player may stay disconnected during play before they Forfeit.
		"FORFEIT_AFTER_SECONDS": 120,
		// The Setup Timer: how long both players have to finish Setup before the
		// Pieces of whoever is not done get a Random Setup.
		"SETUP_TIMER_SECONDS": 180
	},
	"durable_objects": {
		"bindings": [
			{ "name": "LOBBY", "class_name": "LobbyHost" },
			{ "name": "REFEREE", "class_name": "Referee" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["QuickMatchHost", "Referee"] },
		{ "tag": "v2", "new_sqlite_classes": ["LobbyHost"], "deleted_classes": ["QuickMatchHost"] }
	]
}
